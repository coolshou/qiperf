Source: qiperf
Section: network
Priority: optional
Maintainer: coolshou <coolshou2060@gmail.com>
Build-Depends: libsystemd-dev,
    qt5-qmake | qmake6, qtbase5-dev | qt6-base-dev,
    libqt5websockets5-dev | libqt6websockets6-dev | qt6-websockets-dev,
    libqt5serialport5-dev | libqt6serialport6-dev | qt6-serialport-dev,
    qtwebengine5-dev | qt6-webengine-dev,
    qtbase5-private-dev | qt6-base-private-dev,
    qtpositioning5-dev | qt6-positioning-dev,
    freeglut3-dev | libglut-dev
Standards-Version: 4.6.0
Homepage: https://github.com/coolshou/qiperf.git
#Vcs-Browser: https://salsa.debian.org/debian/qiperf
#Vcs-Git: https://github.com/coolshou/qiperf.git
Rules-Requires-Root: no

Package: qiperfc
Architecture: any
Multi-Arch: allowed
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: qt base quick iperf console
 quick iperf console GUI to control qiperfd
