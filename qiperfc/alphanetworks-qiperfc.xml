<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-qip">
    <comment xml:lang="en">qiperf config</comment>
    <generic-icon name="qiperfc"/>
    <magic priority="50">
        <match type="string" value="\x00\x00\x00\x04\x2EQIP" offset="0"/>
    </magic>
    <glob pattern="*.qip"/>
  </mime-type>
  <mime-type type="application/x-qis">
    <comment xml:lang="en">qiperf simple automate</comment>
    <generic-icon name="qiperfc"/>
    <magic priority="50">
        <match type="string" value="\x00\x00\x00\x04\x2EQIS" offset="0"/>
    </magic>
    <glob pattern="*.qis"/>
  </mime-type>
</mime-info>
