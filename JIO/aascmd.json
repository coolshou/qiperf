{
    "GET_PRODUCTTYPE":"getmfg productType",
    "GET_OPMODE":"getmfg opMode",
    "GET_DEPLOY_MODE":"getmfg dplyMode",
    "SET_OPMODE_STA":"mfc set defmfg_sta; mfc set mac_sta 54:2A:A2:CE:BB:A0; mfc set freset",
    "SET_OPMODE_AP":"mfc set defmfg_ap; mfc set mac_ap 54:2A:A2:CE:BB:84; mfc set freset",
    "GET_AIP1VENDOR":"uci get aip.aip1.vendor",
    "GET_AIP2VENDOR":"uci get aip.aip2.vendor",
    "GET_AIP1EIRP":"uci get aip.aip1.eirp",
    "GET_AIP2EIRP":"uci get aip.aip2.eirp",
    "GET_compassOrientation":"uci get system.@system[0].compassOrientation",
    "GET_compassPitch":"uci get system.@system[0].compassPitch",
    "GET_SENSORS":"sensors_call_so",
    "GET_GPS":"gps_call_so",
    "MONOTOR_STA_INFO":"iwpriv rax0 show stainfo",
    "MONOTOR_STA_DATA":{
        "RegExp":"R(^\\s*(?:[0-9a-f]{2}:){5}[0-9a-f]{2}\\s+\\S+\\s+\\d+\\s+\\d+\\s+\\d+/\\d+\\s+\\d+\\s+\\d+\\s+\\d+\\s+(?<RSSI>\\d+/\\d+/--/--)\\s+(?<SNR>\\d+/\\d+/--/--)\\s+\\S+\\s+\\S+\\s+(?<MCS>\\d+/\\d+)\\s+NA/NA)",
        "Key":"STA "
    },
    "GET_AP_INFO":"dmesg -c |grep 'AP '; mwctl apclix0 show stainfo=all; dmesg -c |grep 'AP ';",
    "AP_INFO_MONITOR":{
        "RegExp":"R(^\\s*(?:[0-9a-f]{2}:){5}[0-9a-f]{2}\\s+\\S+\\s+\\d+\\s+\\d+\\s+\\d+/\\d+\\s+\\d+\\s+\\d+\\s+\\d+\\s+(?<RSSI>\\d+/\\d+/--/--)\\s+(?<SNR>\\d+/\\d+/--/--)\\s+\\S+\\s+\\S+\\s+(?<MCS>\\d+/\\d+)\\s+NA/NA)",
        "captured":{
            "RSSI":"/",
            "SNR":"/",
            "MCS":"/"
        },
        "times":10
    },
    "MONOTOR_AP_INFO":"mwctl apclix0 show stainfo=all",

    "SET_AP_MU":"iwpriv rax0 set muruDbgInfo=61-9",
    "SET_AP_MU_OFDMA_DL":"",
    "SET_AP_MU_OFDMA_UL":"",
    "IFNAME":["apclix0"],
    "GET_MAC":"ifconfig %1",
    "MONOTOR_LOG":"logread -f",
    "RESPONSE":{
        "GET_GPS":"GPS_DATA",
        "GET_RSSI":"RSSI_DATA",
        "GET_MCS":"MCS_DATA",
        "GET_SENSORS":"SENSORS_DATA",
        "GET_MAC":"MAC_DATA",
        "GET_PRODUCTTYPE":"PRODUCTTYPE",
        "GET_AP_INFO":"AP_INFO_MONITOR"
    },
    "GPS_DATA":{
        "Latitude:":"\\s*(-?\\d+\\.\\d+)",
        "Longitude:":"\\s*(-?\\d+\\.\\d+)",
        "Altitude (MSL):":"\\s*(-?\\d+\\.\\d+)",
        "Heading:":"\\s*(-?\\d+\\.\\d+)"
    },
    "SENSORS_DATA":{
        "out_heading:":"\\s*(-?\\d+\\.\\d+)",
        "out_headingErr:":"\\s*(-?\\d+\\.\\d+)",
        "out_rotation[1]:":"\\s*(-?\\d+\\.\\d+)",
        "Calibration_status_of_the_Sensors:":"\\s*(-?\\d+\\.\\d+)"
    },
    "MAC_DATA":{
        "HWaddr":"\\s+([0-9A-Fa-f]{2}(?::[0-9A-Fa-f]{2}){5})"
    },
    "PRODUCTTYPE":{
        "Value:":"\\s*(\\w+)"
    }
}
