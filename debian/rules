#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1

DEB_BUILD_OPTIONS=noddebs

#include /usr/share/cdbs/1/rules/debhelper.mk
# see FEATURE AREAS in dpkg-buildflags(1)
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
# package maintainers to append LDFLAGS
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

VERSION_QIPERF := $(shell sed -n -e "s/^#define QIPERF_VERSION //p" src/versions.h)
VERSION_QIPERFD := $(shell sed -n -e "s/^#define QIPERFD_VERSION //p" src/versions.h)
VERSION_QIPERFC := $(shell sed -n -e "s/^#define QIPERFC_VERSION //p" src/versions.h)
VERSION_QIPERFTRAY := $(shell sed -n -e "s/^#define QIPERFTRAY_VERSION //p" src/versions.h)

# sudo qtchooser -install qt6 /usr/lib/qt6/bin/qmake
#export QT_SELECT=qt6

%:
	dh $@

override_dh_builddeb:
	dh_gencontrol -- -pqiperfd -v$(VERSION_QIPERFD) -cdebian/qiperfd.control -DPackage=qiperfd
	dh_builddeb -pqiperfd --filename=qiperfd_$(VERSION_QIPERFD)_$(DEB_BUILD_ARCH).deb

	dh_gencontrol -- -pqiperftray -v$(VERSION_QIPERFTRAY) -cdebian/qiperftray.control -DPackage=qiperftray
	dh_builddeb -pqiperftray --filename=qiperftray_$(VERSION_QIPERFTRAY)_$(DEB_BUILD_ARCH).deb

	dh_gencontrol -- -pqiperfc -v$(VERSION_QIPERFC) -cdebian/qiperfc.control -DPackage=qiperfc
	dh_builddeb -pqiperfc --filename=qiperfc_$(VERSION_QIPERFC)_$(DEB_BUILD_ARCH).deb

override_dh_shlibdeps:
	dh_shlibdeps
	# for ubuntu 24.10 QT6
	sed -i "s/libqt6network6t64/libqt6network6 | libqt6network6t64/g" debian/qiperfd.substvars
